<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvLauncher" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg_top</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginStart">@dimen/card_margin</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
