<?xml version="1.0" encoding="utf-8"?>
<!-- Célula da previsão: hora (linha de cima) ou dia (linha de baixo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/forecast_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/forecast_icon"
        android:layout_width="@dimen/weather_icon_small"
        android:layout_height="@dimen/weather_icon_small"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/forecast_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Mínima (só nos dias) -->
        <TextView
            android:id="@+id/forecast_temp_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Chance de chuva; INVISIBLE (não GONE) quando zero, para as colunas ficarem alinhadas. -->
    <TextView
        android:id="@+id/forecast_precip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:drawableStart="@drawable/ic_drop"
        android:drawablePadding="2dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/weather_rain"
        android:textSize="12sp"
        android:visibility="invisible" />
</LinearLayout>
