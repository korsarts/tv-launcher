<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Duas páginas empilhadas, cada uma com a altura da tela. Trocar de página é só um
         translationY do PagerLayout: sem relayout durante a animação. -->
    <com.korsarts.tvlauncher.PagerLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Página 1 (início): topo, área livre para widgets, favoritos encostados embaixo. -->
        <LinearLayout
            android:id="@+id/home_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingBottom="@dimen/screen_padding_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding_h"
                android:paddingEnd="@dimen/screen_padding_h">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:format12Hour="@string/date_format"
                    android:format24Hour="@string/date_format"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btn_search"
                    style="@style/TopButton"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/search_title"
                    android:src="@drawable/ic_search" />

                <ImageButton
                    android:id="@+id/btn_refresh"
                    style="@style/TopButton"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/weather_refresh"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/btn_options"
                    style="@style/TopButton"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/launcher_options"
                    android:src="@drawable/ic_tune" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    style="@style/TopButton"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>

            <!-- Área de widgets (clima). O conteúdo é inflado pelo WeatherWidget. -->
            <FrameLayout
                android:id="@+id/widget_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="@dimen/screen_padding_h"
                android:paddingEnd="@dimen/screen_padding_h" />

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favorites" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favorites"
                style="@style/AppRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/favorites_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_h"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/screen_padding_h"
                android:layout_marginBottom="24dp"
                android:text="@string/no_favorites"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Indica que há mais conteúdo abaixo (a grade). Não focável. -->
            <TextView
                android:id="@+id/apps_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:drawableEnd="@drawable/ic_expand_more"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:text="@string/all_apps_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Página 2: grade de todos os apps, ocupa a tela inteira. -->
        <LinearLayout
            android:id="@+id/apps_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@dimen/screen_padding_top">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding_h"
                android:layout_marginEnd="@dimen/screen_padding_h"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/all_apps"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps"
                style="@style/AppRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </com.korsarts.tvlauncher.PagerLayout>

    <!-- Painel lateral (menus). Fica GONE quando fechado: zero custo de desenho. -->
    <FrameLayout
        android:id="@+id/panel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/panel_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim"
            android:forceHasOverlappingRendering="false" />

        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="@dimen/panel_width"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="36dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/panel_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/panel_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/panel_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/panel_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:fadingEdge="none"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Campo de texto opcional da página (ex.: busca de cidade). O hint, que
                         serve de rótulo de acessibilidade, vem da página (SidePanel.Input). -->
                    <EditText
                        android:id="@+id/panel_input"
                        tools:ignore="LabelFor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/panel_input_background"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords|textNoSuggestions"
                        android:maxLines="1"
                        android:minHeight="54dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textCursorDrawable="@null"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/panel_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:lineSpacingExtra="3dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text_secondary"
                        android:textIsSelectable="false"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/panel_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
